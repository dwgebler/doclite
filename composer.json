{
    "name": "dwgebler/doclite",
    "version": "2.0.0",
    "keywords": ["nosql","database","document","json","file","sqlite","store"],
    "description": "A powerful NoSQL data store built on top of SQLite",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "swaggest/json-schema": "^0.12.31",
        "symfony/property-access": "^5.4 || ^6.0 || ^7.0",
        "symfony/property-info": "^5.4 || ^6.0 || ^7.0",
        "symfony/serializer": "^5.4 || ^6.0 || ^7.0",
        "symfony/uid": "^5.4 || ^6.0 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "vimeo/psalm": "^6.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {"Gebler\\Doclite\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": { "Gebler\\Doclite\\Tests\\": "tests/" }
    },
    "license": ["MIT"],
    "authors": [
        {
            "name": "David Gebler"
        }
    ]
}
